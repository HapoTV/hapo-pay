# .env.example
# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here_keep_secret
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Django Configuration
SECRET_KEY=your_django_secret_key_at_least_50_chars_long_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.hapopay.com

# Database (Supabase PostgreSQL)
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your_supabase_db_password
DATABASE_HOST=db.your-project.supabase.co
DATABASE_PORT=5432

# JWT Settings
JWT_SECRET_KEY=your_jwt_secret_key_for_django
JWT_ALGORITHM=HS256
ACCESS_TOKEN_LIFETIME=3600
REFRESH_TOKEN_LIFETIME=604800

# External Services
AIRIME_API_KEY=your_airtime_provider_api_key
AIRIME_PROVIDER_URL=https://api.airtimeprovider.com/v1
TRANSPORT_API_KEY=your_transport_api_key
TRANSPORT_API_URL=https://api.transportprovider.com/v1
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_firebase_server_key
FCM_SENDER_ID=your_fcm_sender_id

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@hapopay.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=HapoPay <noreply@hapopay.com>

# Redis for Caching and Channels
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Rate Limiting
RATELIMIT_ENABLE=True
RATELIMIT_RATE=100/hour

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn_url

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
